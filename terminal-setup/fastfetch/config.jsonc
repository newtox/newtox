{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "nobara",
        "color": {
            "1": "38;2;255;103;0",
            "2": "38;2;224;90;0"
        },
        "padding": {
            "top": 2,
            "left": 1,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;255;103;0",
            "title": "1;38;2;255;103;0",
            "separator": "38;2;185;187;190",
            "output": "38;2;220;221;222"
        },
        "key": {
            "width": 13
        },
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "━"
            },
            "color": {
                "elapsed": "38;2;255;103;0",
                "total": "38;2;45;47;52"
            },
            "border": {
                "left": "",
                "right": ""
            },
            "width": 12
        },
        "percent": {
            "type": ["num", "bar"],
            "color": {
                "green": "38;2;255;103;0",
                "yellow": "38;2;224;90;0",
                "red": "38;2;250;119;124"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "1;38;2;255;103;0",
                "at": "38;2;185;187;190",
                "host": "1;38;2;255;255;255"
            }
        },
        {
            "type": "custom",
            "format": "{#38;2;255;103;0}╭──────────── {#1;38;2;255;255;255}System{#0}{#38;2;255;103;0} ────────────────────"
        },
        { "type": "os", "key": "│ OS" },
        { "type": "kernel", "key": "│ Kernel" },
        { "type": "uptime", "key": "│ Uptime" },
        { "type": "packages", "key": "│ Pakete" },
        { "type": "shell", "key": "│ Shell" },
        { "type": "terminal", "key": "│ Terminal" },
        {
            "type": "custom",
            "format": "{#38;2;255;103;0}├──────────── {#1;38;2;255;255;255}Desktop{#0}{#38;2;255;103;0} ───────────────────"
        },
        { "type": "de", "key": "│ DE" },
        { "type": "wm", "key": "│ WM" },
        { "type": "theme", "key": "│ Theme" },
        { "type": "icons", "key": "│ Icons" },
        { "type": "cursor", "key": "│ Cursor" },
        { "type": "font", "key": "│ Font" },
        {
            "type": "display",
            "key": "│ Monitor",
            "format": "{width}x{height} @ {refresh-rate} Hz"
        },
        {
            "type": "custom",
            "format": "{#38;2;255;103;0}├──────────── {#1;38;2;255;255;255}Hardware{#0}{#38;2;255;103;0} ──────────────────"
        },
        { "type": "cpu", "key": "│ CPU" },
        {
            "type": "gpu",
            "key": "│ GPU",
            "format": "{name} ({type})"
        },
        { "type": "memory", "key": "│ RAM" },
        { "type": "swap", "key": "│ Swap" },
        {
            "type": "disk",
            "key": "│ Disk",
            "format": "{size-used} / {size-total} ({size-percentage}) {filesystem}"
        },
        { "type": "localip", "key": "│ IP" },
        {
            "type": "custom",
            "format": "{#38;2;255;103;0}╰──────────────────────────────────────────"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
